{
  "name": "battly-overlay",
  "version": "1.0.0",
  "private": true,
  "description": "Battly Worlds overlay and native window trackers",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build",
