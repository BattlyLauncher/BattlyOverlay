    "test:smoke": "electron examples/host.cjs --smoke"
  },
  "devDependencies": {
    "vite": "8.2.2",
    "typescript": "6.0.3",
    "@types/node": "22.20.1",
    "electron": "43.4.1",
    "adm-zip": "0.6.1"
  }
